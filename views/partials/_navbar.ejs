<nav>
  <% if(user) { %>
    <div class="navbar">
      <h1 id="nav-header">Skyrockit</h1>

      <div class="nav-links">
        <a
          class="authlink"
          href="/users/<%= user._id %>/applications"
        >
          Your Apps
        </a>

        <form action="/auth/sign-out" method="POST">
          <button class="authlink" type="submit">
            Sign Out
          </button>
        </form>
      </div>
    </div>

  <% } else { %>
    <div class="navbar">
      <h1 id="nav-header">Skyrockit</h1>

      <div class="nav-links">
        <a class="authlink" href="/auth/sign-in">
          Sign In
        </a>

        <a class="authlink" href="/auth/sign-up">
          Sign Up
        </a>
      </div>
    </div>
  <% } %>
</nav>